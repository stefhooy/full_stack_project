# Copy this file to .env and fill in values. .env is gitignored.

# --- Model provider (single swappable value; agent code never branches on this) ---
# One of: groq | ollama | gemini
MODEL_PROVIDER=groq

# Groq (default, free tier) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (local dev, no API key needed) — https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Gemini (seam reserved for a later slice as a fallback provider — not implemented yet)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Embeddings / RAG (schema retrieval) ---
# One of: local | ollama
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
RAG_TOP_K=8

# --- Tracing (LangSmith free tier) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-game-analyst
LANGSMITH_TRACING=true

# --- Database ---
DUCKDB_PATH=data/db/games.duckdb

# --- Agent guardrails ---
SQL_MAX_RETRIES=3
SQL_MAX_ROWS=200

# --- Ingestion ---
STEAMSPY_USER_AGENT=ai-game-analyst-ingest/0.1 (contact: your-email@example.com)
INGEST_GAME_COUNT=200
